package {{.Module}}

import domain "{{.DomainImport}}"

// modelToEntity преобразует ответ внешнего сервиса в доменную сущность
func modelToEntity(m *{{.Module}}) *domain.{{.EntityName}} {
	if m == nil {
		return nil
	}

	return &domain.{{.EntityName}}{
		ID: m.ID,
{{- range .Fields}}
		{{.Name}}: m.{{.Name}},
{{- end}}
		Status: m.Status,
	}
}
