package {{.Module}}

import (
	"context"
	"fmt"

	domain "{{.DomainImport}}"
	"github.com/exgamer/gosdk-http-core/pkg/constants"
	"github.com/exgamer/gosdk-http-core/pkg/gin"
	"github.com/exgamer/gosdk-http-request-builder/pkg/builder"

	"{{.ConfigsImport}}"
)

func NewHttpRepository(cfg configs.{{.EntityName}}Config) *HttpRepository {
	return &HttpRepository{cfg: cfg}
}

type HttpRepository struct {
	cfg configs.{{.EntityName}}Config
}

// GetById запрашивает {{.Module}} у внешнего сервиса по id.
// TODO: сверить путь запроса с реальным API — cfg.ServiceHost задаёт только хост.
func (r *HttpRepository) GetById(ctx context.Context, id uint) (*domain.{{.EntityName}}, error) {
	httpInfo := gin.GetHttpInfoFromContext(ctx)

	resp, err := builder.NewGetHttpRequestBuilder[builder.Response[{{.Module}}]](
		ctx,
		fmt.Sprintf("%s/api/v1/{{.TableName}}/%d", r.cfg.ServiceHost, id),
	).SetRequestHeaders(map[string]string{
		constants.RequestIdHeaderName: httpInfo.RequestId,
	}).GetResult()

	if err != nil {
		return nil, err
	}

	return modelToEntity(&resp.Result.Data), nil
}
